# Server Configuration
PORT=3001
NODE_ENV=development

# Convex Configuration
# Get this from: https://dashboard.convex.dev/ -> Your Project -> Settings -> URL
CONVEX_URL=https://your-project.convex.cloud

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI Configuration (Optional - only for Whisper STT if needed)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Configuration
ELEVENLABS_API_KEY=sk_d61acc52472d79742bbfdd9677af1a8f7d30078e79de7b9b
ELEVENLABS_VOICE_ID=ljEOxtzNoGEa58anWyea
ELEVENLABS_AGENT_ID=agent_7101k7v2614becv82e9npajj02f7
# Use a Singaporean English voice for the "Mom" character
# Recommended: Try different voices to find the best "mom" voice
# For Conversational AI: Create an agent at https://elevenlabs.io/app/conversational-ai

# CORS Configuration
# Add all frontend URLs that should be allowed to access the backend
# For production, add your Vercel deployment URL here
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Agent Configuration
AI_AGENT_TEMPERATURE=0.7
AI_AGENT_MAX_TOKENS=500

# Mem0 Configuration
# Get your API key from: https://app.mem0.ai/
MEM0_API_KEY=your_mem0_api_key_here
MEM0_USER_ID_PREFIX=mom_user_

