# Server Configuration
PORT=3001
NODE_ENV=development

# Convex Configuration
# Get this from: https://dashboard.convex.dev/ -> Your Project -> Settings -> URL
CONVEX_URL=https://your-project.convex.cloud

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-exp

# OpenAI Configuration (Optional - only for Whisper STT if needed)
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
# Use a Singaporean English voice for the "Mom" character
# Recommended: Try different voices to find the best "mom" voice

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Agent Configuration
AI_AGENT_TEMPERATURE=0.7
AI_AGENT_MAX_TOKENS=500

